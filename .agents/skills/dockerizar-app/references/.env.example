# ===========================================================================
# Plantilla de variables de entorno. Copia a .env (dev) o .env.qa (QA) y
# rellena valores reales. En producción, define estas variables en la UI del
# orquestador (Dokploy) — NUNCA subas el .env al repositorio.
# ===========================================================================

# App & Security
APP_NAME=miapp
APP_URL=http://localhost:3000
NODE_ENV=development
# Genera valores reales con:  openssl rand -base64 32
NUXT_SECRET=cambia_esto
NUXT_SESSION_PASSWORD=cambia_esto_min_32_chars

# Database (PostgreSQL)
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_DB=app_db
# host 'db' dentro de Docker; 'localhost' para desarrollo nativo.
# En docker-compose la app usa 'db' automáticamente (esta var se sobreescribe).
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/app_db?schema=public

# ---------------------------------------------------------------------------
# Docker - DESARROLLO (puertos publicados al host)
# ---------------------------------------------------------------------------
APP_PORT=3000
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Docker - QA (docker-compose.qa.yml)
# ---------------------------------------------------------------------------
# Puerto del host donde nginx sirve el stack de QA (si no usas dominio).
QA_HTTP_PORT=8080

# ---------------------------------------------------------------------------
# Primer usuario / superadmin (seed)
# ---------------------------------------------------------------------------
SUPERADMIN_NAME=Tu Nombre
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=cambia_esto

# Email (SMTP)
SMTP_HOST=0.0.0.0
SMTP_PORT=1025
SMTP_USER=user
SMTP_PASS=pass
SMTP_FROM=miapp@example.com
